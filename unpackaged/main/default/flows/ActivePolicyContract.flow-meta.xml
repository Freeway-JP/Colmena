    <description>Fix - &lt;Get Opportunity Line Item Bot&gt; se añade filtro para obtener la Oportunidad en gestión: Abierta</description>
    <environments>Default</environments>
    <formulas>
        <name>FechaFin</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>ShortIdAccount</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.NameInsuredId}, LEN({!$Record.NameInsuredId}) - 3)</expression>
    </formulas>
    <interviewLabel>Contrato Poliza Activa {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contrato Poliza Activa</label>
