    </formulas>
    <formulas>
        <name>var_numeroPoliza</name>
        <dataType>String</dataType>
        <expression>IF(
    {!var_conEspacio},
    MID({!$Record.Description}, {!var_PosicionContrato} , FIND(&quot; &quot;, MID({!$Record.Description},{!var_PosicionContrato}+1, 60))),
    MID({!$Record.Description}, {!var_PosicionContrato} , FIND(&quot;_&quot;, MID({!$Record.Description},{!var_PosicionContrato}, 20))-5)
)</expression>
    </formulas>
    <formulas>
