    <formulas>
        <name>var_Characters</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!$Record.Description}, &quot;Contrato&quot;),
    SUBSTITUTE(
        SUBSTITUTE(
            TRIM(
                LEFT(
                    RIGHT({!$Record.Description}, LEN({!$Record.Description}) - FIND(&quot;Contrato&quot;, {!$Record.Description}) - LEN(&quot;Contrato&quot;)),
                    FIND(&quot; &quot;, RIGHT({!$Record.Description}, LEN({!$Record.Description}) - FIND(&quot;Contrato&quot;, {!$Record.Description}) - LEN(&quot;Contrato&quot;)))
                )
            ),
            &quot;_&quot;,
            &quot;&quot;
        ),
        &quot;Microsoft&quot;,
        &quot;&quot;
    ),
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>var_conEspacio</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    FIND(&quot; &quot;, MID({!$Record.Description},{!var_PosicionContrato} , 20)) &gt;= 1,
    true,
    false
)</expression>
    </formulas>
    <formulas>
        <name>var_FechaFinMayor</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.EndDateTime} &lt;= DATETIMEVALUE(TODAY()), true, false)</expression>
    </formulas>
    <formulas>
