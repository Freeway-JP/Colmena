        <expression>IF(ISBLANK({!NewQuote.OfferCost__c}), IF(ISBLANK({!FinancialViability.CS_DirectPreventionActivities_Anali_Vert__c}), null, {!FinancialViability.CS_DirectPreventionActivities_Anali_Vert__c}), {!NewQuote.OfferCost__c})</expression>
