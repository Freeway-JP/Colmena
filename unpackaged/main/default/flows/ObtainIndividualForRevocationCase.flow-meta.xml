        <name>AccountTypeValidation</name>
        <label>Validar Tipo de Cuenta</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>VoidReturn</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Valor No Valido</defaultConnectorLabel>
        <rules>
            <name>Personal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetRecordTypeAccount.DeveloperName</leftValueReference>
