    <formulas>
        <name>CaminoVentaForm</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!MessageText}, &#39;_&#39;),
    &#39;Canal Presencial&#39;,
    &#39;Canal WhatsApp&#39;
)</expression>
    </formulas>
    <formulas>
        <name>esCuadrillaForm</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  ISBLANK({!SucursalOrigen}),
  false,
  CONTAINS(LOWER({!SucursalOrigen}), &quot;c&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>MessageTextForm</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS(
        RIGHT(
            {!MessageText},
            LEN({!MessageText}) - FIND(&quot; &quot;, {!MessageText}, FIND(&quot; &quot;, {!MessageText}) + 1)
        ),
        &quot;_&quot;
    ),
    LEFT(
        {!MessageText},
        LEN({!MessageText}) - LEN(
            RIGHT(
                {!MessageText},
                LEN({!MessageText}) - FIND(&quot; &quot;, {!MessageText}, FIND(&quot; &quot;, {!MessageText}) + 1)
            )
        )
    ) &amp;
    LEFT(
        RIGHT(
            {!MessageText},
            LEN({!MessageText}) - FIND(&quot; &quot;, {!MessageText}, FIND(&quot; &quot;, {!MessageText}) + 1)
        ),
        FIND(&quot;_&quot;, RIGHT(
            {!MessageText},
            LEN({!MessageText}) - FIND(&quot; &quot;, {!MessageText}, FIND(&quot; &quot;, {!MessageText}) + 1)
        )) - 1
    ),
    {!MessageText}
)</expression>
    </formulas>
    <formulas>
        <name>MessageTextFormVistaPrevia</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!MessageText}, &quot;_&quot;),
    LEFT({!MessageText}, FIND(&quot;_&quot;, {!MessageText}) - 1),
    {!MessageText}
)</expression>
    </formulas>
    <formulas>
        <name>SurcursalOrigenForm</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!MessageText}, &#39;_&#39;),
    MID(
        {!MessageText},
        FIND(&quot;_&quot;, {!MessageText}) + 1,
        LEN({!MessageText}) - FIND(&quot;_&quot;, {!MessageText})
    ),
    null
)</expression>
    </formulas>
