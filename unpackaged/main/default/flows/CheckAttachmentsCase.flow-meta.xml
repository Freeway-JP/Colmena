        <locationY>0</locationY>
        <connector>
            <targetReference>GetRecordsContentDocumentLink</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeCase__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Validación Comercial de Afinidad</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Reasegurador</stringValue>
            </value>
        </filters>
