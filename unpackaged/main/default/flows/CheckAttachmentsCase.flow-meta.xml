        </defaultConnector>
        <defaultConnectorLabel>No Tiene Archivos Adjuntos</defaultConnectorLabel>
        <rules>
            <name>Youhaveattachedfiles</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetRecordsContentDocumentLink</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Tiene Archivos Adjuntos?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Adjuntar Archivo Caso {!$Flow.CurrentDateTime}</interviewLabel>
