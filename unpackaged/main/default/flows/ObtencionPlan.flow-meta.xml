    <formulas>
        <name>productoPrincipalCortado</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!NombreProductoPrincipal}, &quot;*&quot;),
    MID(
        {!NombreProductoPrincipal}, 
        FIND(&quot;*&quot;, {!NombreProductoPrincipal}) + 1, 
        FIND(&quot;*&quot;, {!NombreProductoPrincipal}, FIND(&quot;*&quot;, {!NombreProductoPrincipal}) + 1) - FIND(&quot;*&quot;, {!NombreProductoPrincipal}) - 1
    ),
    {!NombreProductoPrincipal}
)</expression>
    </formulas>
