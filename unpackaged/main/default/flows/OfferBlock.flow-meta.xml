ISPICKVAL({!$Record.Status}, &quot;Aprobada&quot;),
NOT(ISCHANGED({!$Record.Status})), 
NOT(ISCHANGED({!$Record.IsSyncing})),
NOT(ISCHANGED({!$Record.IntermediariesCommission__c})),
