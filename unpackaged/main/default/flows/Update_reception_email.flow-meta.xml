    <description>Cambios para integrar email to case con la capa media
Se agrega Asignación automática de Cuenta, contacto y mapeo correcto de los campos de la cuenta</description>
    <environments>Default</environments>
    <formulas>
        <name>Description</name>
        <dataType>String</dataType>
        <expression>MID(
    $Record.Parent.Description,
    FIND(&quot;Asunto: &quot;, $Record.Parent.Description) + LEN(&quot;Asunto: &quot;),
    LEN($Record.Parent.Description)
)</expression>
    </formulas>
    <formulas>
        <name>FinalDescription</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!Description} != null,
        BEGINS({!Description}, {!SubjectIntegration})
    ),
    TRIM(
        MID(
            {!Description}, 
            LEN({!SubjectIntegration}) + 1, 
            LEN({!Description})
        )
    ),
    TRIM({!Description})
)</expression>
    </formulas>
    <formulas>
        <name>FromAddressIntegration</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS($Record.TextBody, &quot;|||from:&quot;),
    IF(
        CONTAINS(
            MID(
                $Record.TextBody,
                FIND(&quot;|||from:&quot;, $Record.TextBody) + 8,
                FIND(&quot;~~&quot;, $Record.TextBody, FIND(&quot;|||from:&quot;, $Record.TextBody)) - (FIND(&quot;|||from:&quot;, $Record.TextBody) + 8)
            ),
            &quot;&lt;&quot;
        ),
        LEFT(
            MID(
                $Record.TextBody,
                FIND(&quot;|||from:&quot;, $Record.TextBody) + 8,
                FIND(&quot;~~&quot;, $Record.TextBody, FIND(&quot;|||from:&quot;, $Record.TextBody)) - (FIND(&quot;|||from:&quot;, $Record.TextBody) + 8)
            ),
            FIND(&quot;&lt;&quot;, 
                MID(
                    $Record.TextBody,
                    FIND(&quot;|||from:&quot;, $Record.TextBody) + 8,
                    FIND(&quot;~~&quot;, $Record.TextBody, FIND(&quot;|||from:&quot;, $Record.TextBody)) - (FIND(&quot;|||from:&quot;, $Record.TextBody) + 8)
                )
            ) - 1
        ),
        MID(
            $Record.TextBody,
            FIND(&quot;|||from:&quot;, $Record.TextBody) + 8,
            FIND(&quot;~~&quot;, $Record.TextBody, FIND(&quot;|||from:&quot;, $Record.TextBody)) - (FIND(&quot;|||from:&quot;, $Record.TextBody) + 8)
        )
    ),
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>GetEmail</name>
        <dataType>String</dataType>
        <expression>MID(
    {!$Record.Headers},
    FIND(&#39;@&#39;, {!$Record.Headers}, FIND(&#39;X-SFDC-Original-RCPT:&#39;, {!$Record.Headers})) + 1,
    LEN({!$Record.Headers}) - FIND(&#39;@&#39;, {!$Record.Headers}, FIND(&#39;X-SFDC-Original-RCPT:&#39;, {!$Record.Headers}))
)</expression>
    </formulas>
    <formulas>
        <description>Campo para obtener el asunto del correo reenviado desde Power automate</description>
        <name>SubjectIntegration</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.Subject}, LEN({!$Record.Subject}) - 4)</expression>
    </formulas>
    <formulas>
        <name>ToAddressIntegration</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS($Record.TextBody, &quot;~~to:&quot;),
    IF(
        CONTAINS(
            MID(
                $Record.TextBody,
                FIND(&quot;~~to:&quot;, $Record.TextBody) + 5,
                FIND(&quot;|&quot;, $Record.TextBody, FIND(&quot;~~to:&quot;, $Record.TextBody)) - (FIND(&quot;~~to:&quot;, $Record.TextBody) + 5)
            ),
            &quot;&lt;&quot;
        ),
        LEFT(
            MID(
                $Record.TextBody,
                FIND(&quot;~~to:&quot;, $Record.TextBody) + 5,
                FIND(&quot;|&quot;, $Record.TextBody, FIND(&quot;~~to:&quot;, $Record.TextBody)) - (FIND(&quot;~~to:&quot;, $Record.TextBody) + 5)
            ),
            FIND(&quot;&lt;&quot;, 
                MID(
                    $Record.TextBody,
                    FIND(&quot;~~to:&quot;, $Record.TextBody) + 5,
                    FIND(&quot;|&quot;, $Record.TextBody, FIND(&quot;~~to:&quot;, $Record.TextBody)) - (FIND(&quot;~~to:&quot;, $Record.TextBody) + 5)
                )
            ) - 1
        ),
        MID(
            $Record.TextBody,
            FIND(&quot;~~to:&quot;, $Record.TextBody) + 5,
            FIND(&quot;|&quot;, $Record.TextBody, FIND(&quot;~~to:&quot;, $Record.TextBody)) - (FIND(&quot;~~to:&quot;, $Record.TextBody) + 5)
        )
    ),
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>ValidateFinalDescription</name>
        <dataType>String</dataType>
        <expression>IF(
    LEN(TRIM({!FinalDescription})) &gt; 31900,
    LEFT(TRIM({!FinalDescription}), 31900),
    TRIM({!FinalDescription})
)</expression>
    </formulas>
    <formulas>
        <name>ValidateToAddressIntegation</name>
        <dataType>String</dataType>
