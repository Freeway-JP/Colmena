    DATETIMEVALUE(
        TEXT(YEAR({!RecordEntitlement.StartDate})) &amp; &quot;-&quot; &amp; 
        TEXT(MONTH({!RecordEntitlement.StartDate})) &amp; &quot;-&quot; &amp; 
        TEXT(DAY({!RecordEntitlement.StartDate}) + 1) &amp; &quot; 08:00:00&quot;
    ),
