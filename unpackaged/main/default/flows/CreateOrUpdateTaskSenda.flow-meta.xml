        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Resultado predeterminado</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5 OR 6) AND 7</conditionLogic>
            <conditions>
                <leftValueReference>ElementsWhatId.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Queja</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ElementsWhatId.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Derecho de peticion</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ElementsWhatId.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Incidente</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ElementsWhatId.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Queja Supersalud</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ElementsWhatId.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requerimiento Jurídico</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ElementsWhatId.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Queja Superintendencia</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ElementsWhatId.CS_Numero_de_ATEL__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateOrUpdateTaskSenda</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
