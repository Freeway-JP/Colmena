    <decisions>
        <description>Permite identificar si es un caso relacionado con la integración con Senda: Queja, Derecho de peticion, Incidente, Queja Supersalud, Requerimiento Jurídico, Queja Superintendencia.</description>
        <name>IsSendaCase</name>
