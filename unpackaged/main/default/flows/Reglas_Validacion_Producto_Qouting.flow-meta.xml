        <rules>
            <name>ProductSchoolsCollectiveLife</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>GetProductOffer.ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>31314241</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetProductOffer.ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>42324221</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>MesInicioPoliza</leftValueReference>
