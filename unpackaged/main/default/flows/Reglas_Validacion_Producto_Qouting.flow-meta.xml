                <targetReference>MessageError</targetReference>
            </connector>
            <label>Producto( Escolares/Vida colectiva)</label>
        </rules>
        <rules>
            <name>ProductShortTermAccident</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetProductOffer.ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>31314231</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StartPolicyTerm__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Today</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mensaje_de_error_personalizado_2</targetReference>
            </connector>
            <label>Producto (Accidentes corto plazo)</label>
        </rules>
        <rules>
            <name>ValidationSchoolLifeCollection365Days</name>
            <conditionLogic>(1 OR 2 OR 4) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>GetProductOffer.ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>31314241</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetProductOffer.ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>42324221</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndQuotingPolicyTerm__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>FechaInicioPoliza</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetProductOffer.ProductCode__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>31314231</stringValue>
                </rightValue>
            </conditions>
