<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Fecha_limite_creacion_Opp</name>
        <label>Fecha limite creación Opp</label>
        <locationX>380</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Resultado predeterminado</defaultConnectorLabel>
        <rules>
            <name>X60_dias_o_mas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CreatedDateFormated</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>FechaLimiteCierreOppBot</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetOpportunityLineItemBot</targetReference>
            </connector>
            <label>60 dias o mas</label>
        </rules>
    </decisions>
    <decisions>
        <name>UpdateOpportunityStage</name>
        <label>Póliza Encontrada</label>
        <locationX>182</locationX>
        <locationY>576</locationY>
        <defaultConnectorLabel>Resultado predeterminado</defaultConnectorLabel>
        <rules>
            <name>No_Encontrada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetInsurancePolicy.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_Opp_Bot</targetReference>
            </connector>
            <label>No Encontrada</label>
        </rules>
    </decisions>
    <description>Cierre de oportunidades que no tiene póliza existente en el plazo establecido.</description>
    <environments>Default</environments>
    <formulas>
        <name>CreatedDateFormated</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>DiasUltimaModificacion</name>
        <dataType>Number</dataType>
        <expression>NOW() - {!$Record.LastModifiedDate}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FechaLimiteCierreOppBot</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 110</expression>
    </formulas>
    <interviewLabel>Cierre Oportunidad sin póliza {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cierre Oportunidad sin póliza</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetInsurancePolicy</name>
        <label>Obtener Póliza</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UpdateOpportunityStage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ProductId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetOpportunityLineItemBot.Product2Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProductId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NameInsuredId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>SourceOpportunityId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>InsurancePolicy</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetOpportunityLineItemBot</name>
        <label>Obtener Producto de Oportunidad</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetInsurancePolicy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Product2Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Close_Opp_Bot</name>
        <label>Cerrar Opp Bot</label>
        <locationX>50</locationX>
        <locationY>684</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>DescriptionLoss</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Motivo_de_perdida__c</field>
            <value>
                <stringValue>No Interesado</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Cerrada Perdida</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sub_motivo_de_perdida__c</field>
            <value>
                <stringValue>No Interesado - sin motivo</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Fecha_limite_creacion_Opp</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>opportunitySource__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ORG005</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>NotEqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-07-30</startDate>
            <startTime>17:11:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>DescriptionLoss</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Cierre de oportunidad automático al no evidenciar gestión pasados 60 días.</text>
    </textTemplates>
</Flow>
